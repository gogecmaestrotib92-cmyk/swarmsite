{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "swarmsite/templates/data",
  "title": "The data one client gives every reference template",
  "description": "Written from the templates' CONTRACT.md (2026-11-12, with its section \"Businesses that are not software\": team, catalogue, locations, credentials, contact, projects). The same file feeds every template. Any list may be empty and any optional block missing; a section whose data is missing is left out whole. Unknown keys are allowed (hand-made files carry notes such as _sources); the known keys must have these shapes. Only brand.name and hero.title are required: a page needs a name and one heading.",
  "type": "object",
  "required": [
    "brand",
    "hero"
  ],
  "definitions": {
    "link": {
      "type": "object",
      "required": [
        "t"
      ],
      "properties": {
        "t": {
          "type": "string",
          "minLength": 1
        },
        "h": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "colour": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "picture": {
      "type": "object",
      "required": [
        "src"
      ],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        },
        "alt": {
          "type": "string"
        },
        "shape": {
          "type": "string"
        },
        "role": {
          "enum": [
            "dish",
            "room",
            "bar",
            "exterior",
            "people",
            "other",
            "work",
            "workshop",
            "portrait",
            "product",
            "detail",
            "landscape",
            "action"
          ]
        },
        "small": {
          "type": "boolean"
        },
        "lettering": {
          "type": "boolean",
          "description": "words are drawn into the picture (OCR, lib/templates/lettering.py)"
        },
        "page": {
          "type": "string",
          "description": "the address of the client's page the picture was found on"
        }
      }
    },
    "made": {
      "type": "object",
      "required": [
        "src"
      ],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "w": {
          "type": "integer"
        },
        "h": {
          "type": "integer"
        },
        "tone": {
          "enum": [
            "dark",
            "light"
          ]
        },
        "hue": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "postcode": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "phone": {
      "type": "object",
      "required": [
        "t"
      ],
      "properties": {
        "t": {
          "type": "string",
          "minLength": 1
        },
        "h": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "hours": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "days",
          "open",
          "close"
        ],
        "properties": {
          "days": {
            "type": "string",
            "minLength": 1
          },
          "open": {
            "type": "string",
            "minLength": 1
          },
          "close": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "person": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "img": {
          "type": "string"
        },
        "h": {
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "offer": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "price": {
          "type": "string"
        },
        "from": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "note": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "img": {
          "type": "string"
        },
        "h": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": "string"
        },
        "prices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "price"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "price": {
                "type": "string"
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "properties": {
    "brand": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
