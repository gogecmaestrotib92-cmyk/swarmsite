{
  "schema_version": 1,
  "patterns": [
    {
      "id": "story-assigned-product-ui",
      "version": 1,
      "move": "story",
      "allowed_beat_types": [
        "features"
      ],
      "allowed_site_kinds": [
        "software",
        "product"
      ],
      "item_count": {
        "min": 2,
        "max": 4
      },
      "asset": {
        "required": true,
        "source": "beat.image",
        "kind": "explicitly-assigned-product-screenshot",
        "minimum_pixel_width": 500,
        "aspect_ratio_min": 0.6,
        "aspect_ratio_max": 2.5,
        "must_be_readable_raster": true,
        "must_be_nonempty": true,
        "must_not_have_item_images": true
      },
      "fallback": "decline-and-keep-original-direction",
      "expected_render": {
        "section_class": "story",
        "item_container": "st-l"
      },
      "implementation_source": "lib/render/render_bp.py:story + component_for",
      "reference": {
        "blueprint_id": "butter",
        "observed_role": "story",
        "url": "https://www.butter.video/"
      },
      "limitations": "Conservative subset only; other story forms may exist. Actual renderer and ownership are verified by a dry run."
    },
