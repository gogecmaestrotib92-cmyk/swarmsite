{"cleanUrls": true, "trailingSlash": false,
 "headers": [
  {"source": "/fonts/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
  {"source": "/js/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800"}]},
  {"source": "/(.*).webp", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800"}]}
 ]}
